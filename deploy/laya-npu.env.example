# /etc/laya-npu.env (or ~/laya-strix/deploy/laya-npu.env)
# Paths assume the repo is at ~/laya-strix and the split artifacts at
# ~/laya-strix/artifacts/onnx/english_split.

LAYA_MODEL_DIR=/home/alyta/laya-strix/artifacts/onnx/english_split
LAYA_ENCODER=/home/alyta/laya-strix/artifacts/ep/english_b1_l512_m8.onnx
LAYA_HEAD=/home/alyta/laya-strix/artifacts/onnx/english_split/head.onnx
LAYA_PROVIDER=VitisAIExecutionProvider
LAYA_EP_CONFIG=/home/alyta/laya-strix/deploy/vai_ep_config.json
LAYA_EP_CACHE=/home/alyta/laya-strix/artifacts/ep-cache
LAYA_EP_CACHE_KEY=english_b1_l512_m8
LAYA_SEQ_LEN=512
LAYA_MARKERS=8
LAYA_BATCH=1

# Jev endpoint.  Keep loopback for the SSH-tunnel path; set 0.0.0.0 only with
# LAYA_API_KEY (the upstream server enforces the bearer token).
LAYA_HOST=127.0.0.1
LAYA_PORT=8751
LAYA_LOG_LEVEL=info

# Optional: uncomment for a CPU-only smoke test when the NPU stack is down.
# LAYA_ALLOW_CPU_FALLBACK=1
