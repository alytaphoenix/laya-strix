[Unit]
Description=Laya decision engine on the XDNA2 NPU (Jev /v1/systemone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alyta
Group=alyta
UMask=0077
WorkingDirectory=/home/alyta/laya-strix
# The env file is read by systemd as root; keep it 0600.  It may point at
# LAYA_API_KEY_FILE and the TLS key/cert paths instead of holding secrets.
EnvironmentFile=/home/alyta/laya-strix/deploy/laya-npu.env
ExecStart=/home/alyta/laya-strix/deploy/run-laya-npu.sh
Restart=always
RestartSec=2

# XRT maps its device heap with MAP_LOCKED.
LimitMEMLOCK=infinity

# Leave the rest of the box to gufo.  The encoder is on the NPU; the remaining
# work is tokenization and a 2-thread CPU head.  Four cores is enough, and the
# coexistence bench showed that letting the head fan out to every core
# starves gufo's CPU sampling loop.
CPUAffinity=0-3
Nice=10
IOSchedulingClass=idle

# Laya is ~1.5 GB of BF16 encoder contexts + ~0.1 GB head + a small runtime.
# Bound it so a burst cannot evict Flash-Next's KV/cache.
MemoryHigh=4G
MemoryMax=5G

# NPU device access (the installed udev rule makes it 0666, but be explicit).
DeviceAllow=/dev/accel/accel0 rw

[Install]
WantedBy=multi-user.target
