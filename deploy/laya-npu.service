[Unit]
Description=Laya decision engine on the XDNA2 NPU (Jev /v1/systemone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alyta
Group=alyta
WorkingDirectory=/home/alyta/laya-strix
EnvironmentFile=/home/alyta/laya-strix/deploy/laya-npu.env
ExecStart=/home/alyta/laya-strix/deploy/run-laya-npu.sh
Restart=always
RestartSec=2

# XRT maps its device heap with MAP_LOCKED.
LimitMEMLOCK=infinity

# Leave the rest of the box to gufo.  Laya's tokenizer is single-threaded and
# the CPU head is small; 8 cores is ample.  Tune after the coexistence bench.
CPUAffinity=0-7
Nice=5
IOSchedulingClass=idle

# Laya is ~1.6 GB of BF16 encoder + ~0.1 GB head + a small runtime.  Bound it
# so a burst cannot evict Flash-Next's KV/cache.
MemoryHigh=3G
MemoryMax=4G

# NPU device access (the installed udev rule makes it 0666, but be explicit).
DeviceAllow=/dev/accel/accel0 rw

[Install]
WantedBy=multi-user.target
