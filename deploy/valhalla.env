# Source AFTER the Ryzen AI venv is active and AFTER /opt/xilinx/xrt/setup.sh.
#
#   source /opt/xilinx/xrt/setup.sh
#   source ~/ryzenai_1_8/venv/bin/activate
#   source deploy/valhalla.env
#
# The two non-obvious paths are documented in the Ryzen AI 1.8-on-26.04
# workarounds:
#   * libonnxruntime_vitisai_ep.so needs libpeano-lib.so.21.0git, which ships
#     under site-packages/lnx64.o/tools/peano/lib and is not on the documented
#     LD_LIBRARY_PATH.  Without it the VitisAI EP silently falls back to CPU.
#   * venv/activate puts voe/lib ahead of /opt/xilinx/xrt/lib and voe/lib ships
#     a stale libxrt_coreutil; keep XRT first.

if [ -z "${RYZEN_AI_INSTALLATION_PATH:-}" ]; then
  echo "valhalla.env: RYZEN_AI_INSTALLATION_PATH is unset; activate the Ryzen AI venv first" >&2
  return 1 2>/dev/null || exit 1
fi

export LD_LIBRARY_PATH="/lib/x86_64-linux-gnu:${RYZEN_AI_INSTALLATION_PATH}/onnxruntime/lib/:${RYZEN_AI_INSTALLATION_PATH}/lib/python3.12/site-packages/lnx64.o/tools/peano/lib:${LD_LIBRARY_PATH:-}"
export LD_LIBRARY_PATH="/opt/xilinx/xrt/lib:${LD_LIBRARY_PATH}"

# libflexmlrt (the VAIML runtime) links against libpython3.12.so.1.0.  The venv
# interpreter is uv-managed, so its base libdir is not on the default loader
# path; add it explicitly.  Without this the EP compiles the model but fails
# when it tries to instantiate the runtime ("cannot open shared object file").
if command -v python >/dev/null 2>&1; then
  _laya_py_libdir="$(python -c 'import sysconfig; print(sysconfig.get_config_var("LIBDIR") or "")' 2>/dev/null || true)"
  if [ -n "${_laya_py_libdir:-}" ]; then
    export LD_LIBRARY_PATH="${_laya_py_libdir}:${LD_LIBRARY_PATH}"
  fi
  unset _laya_py_libdir
fi
